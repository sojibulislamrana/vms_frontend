# ==============================================================================
# VMS Frontend Environment Configuration
# ==============================================================================
# In Flutter, environment variables are passed at build/run time using --dart-define:
#
# Development (default: http://localhost:8080):
#   flutter run -d chrome --dart-define=API_BASE_URL=http://localhost:8080
#
# Production:
#   flutter build web --dart-define=API_BASE_URL=https://vms-api.example.com
#
# Or with a JSON define file (Flutter 3.7+):
#   flutter run -d chrome --dart-define-from-file=env.json
# ==============================================================================

API_BASE_URL=http://localhost:8080

